# Python reads this file without executing shell code.
# Prefer /dev/serial/by-path/... after confirming the two physical port roles.
# The reinstalled Pi currently lists only one CH340: check before running.
ROBOT_SERIAL_PORT=/dev/ttyUSB0
VOICE_SERIAL_PORT=""
ROBOT_BAUD=115200
ROBOT_AUDIO_CARD=wm8960soundcard
ROBOT_SPEAKER_VOLUME=120
ROBOT_CAMERA_DEVICE=/dev/v4l/by-id/usb-lihappe8_Corp._USB_2.0_Camera-video-index0
ROBOT_CAMERA_FPS=15
ROBOT_CAMERA_BACKEND=usb
ROBOT_CAMERA_FLIP=0
ROBOT_MOTION_SCALE=1.5
ROBOT_WALK_SCALE=2.5
ROBOT_ACTION_INTERVAL=0.8
ROBOT_FRAME_EXTRA_DELAY=0
ROBOT_HEAD_LEVEL=95
ROBOT_HEAD_DOWN=120
ROBOT_HEAD_DRIVE_SECONDS=0.8
ROBOT_TTS_SPEED=150
ROBOT_EMOTION_CONFIDENCE=0.52
ROBOT_SAD_CONFIDENCE=0.95
ROBOT_MIC_DEVICE=""

# Existing five-person recognition; calibrate on held-out field data.
ROBOT_FACE_CONFIDENCE=0.65
ROBOT_FACE_CONFIRM_FRAMES=2

# Dual kick only; other tasks retain the original primary USB camera.
ROBOT_KICK_HEAD_DEVICE=/dev/v4l/by-id/usb-lihappe8_Corp._USB_2.0_Camera-video-index
ROBOT_KICK_HEAD_FLIP=0
ROBOT_KICK_BELLY_DEVICE=0
ROBOT_KICK_BELLY_FLIP=none

ROBOT_KICK_MODE=dual
